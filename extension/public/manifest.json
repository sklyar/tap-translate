{
  "manifest_version": 3,
  "name": "TapTranslate",
  "description": "Translates English words on webpages using their surrounding context.",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["translation-sheet.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
