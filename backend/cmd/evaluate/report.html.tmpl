<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TapTranslate eval: {{.Model}}</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #fff; --fg: #1d1d1f; --muted: #6e6e73; --line: #d2d2d7;
    --panel: #f5f5f7; --mark: #ffe58a; --bad: #c62828; --link: #0060df;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1c1e; --fg: #f2f2f7; --muted: #a1a1a6; --line: #3a3a3c;
      --panel: #2c2c2e; --mark: #7a5d00; --bad: #ff6b6b; --link: #6ea8ff;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto; max-width: 1200px; padding: 24px 16px 64px;
    background: var(--bg); color: var(--fg);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 40px 0 12px; }
  .meta, .muted { color: var(--muted); }
  a { color: var(--link); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; vertical-align: top; padding: 6px 8px; border-bottom: 1px solid var(--line); }
  th { font-weight: 600; white-space: nowrap; }
  td.num, th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  pre { white-space: pre-wrap; background: var(--panel); padding: 12px; border-radius: 8px; font-size: 13px; }
  .sample { border-top: 2px solid var(--line); padding-top: 16px; margin-top: 32px; }
  .sample h3 { font-size: 16px; margin: 0; }
  .sentence { font-size: 16px; margin: 8px 0; }
  mark { background: var(--mark); color: inherit; padding: 0 2px; border-radius: 3px; }
  .expected { background: var(--panel); padding: 6px 10px; border-radius: 6px; display: inline-block; }
  .error { color: var(--bad); }
  .expression { font-weight: 600; }
  .variant { white-space: nowrap; }
</style>
</head>
<body>
<h1>TapTranslate eval: {{.Model}}</h1>
<p class="meta">{{.Started}} · {{len .Samples}} samples · {{len .Runs}} requests · {{.Duration}}</p>
{{if .Interrupted}}<p class="error">The run was interrupted. The numbers cover only the finished requests.</p>{{end}}

<h2>Summary</h2>
<div class="scroll">
<table>
  <tr>
    <th>Variant</th><th class="num">Valid</th><th class="num">Failed</th><th class="num">p50, ms</th><th class="num">p95, ms</th><th class="num">max, ms</th>
    <th class="num">Input tokens</th><th class="num">Output tokens</th>{{if .HasPrices}}<th class="num">$ per 1,000</th>{{end}}
  </tr>
  {{range .Summaries}}
  <tr>
    <td class="variant">{{.Name}}</td>
    <td class="num">{{.Valid}}/{{.Requests}}</td>
    <td class="num">{{.Failed}}</td>
    <td class="num">{{.LatencyP50Ms}}</td>
    <td class="num">{{.LatencyP95Ms}}</td>
    <td class="num">{{.LatencyMaxMs}}</td>
    <td class="num">{{one .MeanInputTokens}}</td>
    <td class="num">{{one .MeanOutputTokens}}</td>
    {{if $.HasPrices}}<td class="num">{{usd .CostPer1000}}</td>{{end}}
  </tr>
  {{end}}
</table>
</div>
<p class="muted">Valid: answers that pass validation. Failed: requests without a model answer (HTTP or network errors, timeouts). Latency is the full request time measured by the client; it includes timeouts but not other failed requests. Token counts are means per answered request; output tokens include thinking tokens.{{if .HasPrices}} Prices: ${{.InputPrice}} per 1M input tokens, ${{.OutputPrice}} per 1M output tokens.{{end}}</p>

<details>
  <summary>System prompt</summary>
  <pre>{{.SystemPrompt}}</pre>
</details>

<h2>Samples</h2>
{{range .Samples}}
<section class="sample" id="{{.ID}}">
  <h3>{{.ID}}</h3>
  <div class="muted">{{.Kind}} · {{.Case}} · <a href="{{.URL}}">{{.URL}}</a></div>
  <p class="sentence">{{.Sentence.BeforeWord}}<mark>{{.Sentence.Word}}</mark>{{.Sentence.AfterWord}}</p>
  <p class="expected">Ожидается: {{.Expected}}</p>
  <div class="scroll">
  <table>
    <tr><th>Variant</th><th>Expression</th><th>Translation</th><th>Explanation</th><th class="num">ms</th><th class="num">Tokens</th></tr>
    {{range .Runs}}
    <tr>
      <td class="variant">{{.Name}}</td>
      {{if .Result}}
      <td><span class="expression">{{.Result.Expression}}</span><br><span class="muted">{{.Result.PartOfSpeech}}</span></td>
      <td>{{.Result.Translation}}</td>
      <td>{{.Result.Explanation}}</td>
      {{else}}
      <td colspan="3" class="error">{{.Error}}{{if .Content}}<pre>{{.Content}}</pre>{{end}}</td>
      {{end}}
      <td class="num">{{.LatencyMs}}</td>
      <td class="num">{{.InputTokens}} / {{.OutputTokens}}</td>
    </tr>
    {{end}}
  </table>
  </div>
</section>
{{end}}
</body>
</html>
